# Copy to `.env.local` for local development. Never commit real values.

# --- Required for catalog sync (server only) ---
ARTIFICIALANALYSIS_API_KEY=
BLOB_READ_WRITE_TOKEN=

# --- Required for password-gated writes (sync, Hub refresh, report/guide generation) ---
# Use a long random string; this is compared on the server only.
SYNC_PASSWORD=

# --- Gemini (server only) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Optional: Hugging Face (gated models / Hub refresh) ---
HF_TOKEN=

# --- Feature flags ---
# Public deployments: leave false unless you accept unauthenticated chat cost/abuse risk.
AGENT_ENABLED=false
